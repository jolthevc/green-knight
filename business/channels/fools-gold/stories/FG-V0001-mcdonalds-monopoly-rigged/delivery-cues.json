  "cues": [
    {
      "paragraph_id": "P001",
      "anchor": "Imagine peeling a Monopoly sticker from a McDonald's drink. You might be on",
      "pace": "natural",
      "intent": "curious",
      "emphasis": [
        "The man responsible for protecting them"
