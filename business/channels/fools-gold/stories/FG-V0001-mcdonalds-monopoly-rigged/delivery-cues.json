      "pause_after_seconds": 0,
      "inflection": "curious question",
      "pronunciation_notes": []
    },
    {
      "paragraph_id": "P015",
      "anchor": "By 2000, an anonymous tip had reached the FBI's Jacksonville office. Contem",
      "pace": "natural",
      "intent": "curious",
      "emphasis": [
        "anonymous tip"
      ],
      "pause_after_seconds": 1,
      "inflection": "curious question",
      "pronunciation_notes": []
    },
    {
