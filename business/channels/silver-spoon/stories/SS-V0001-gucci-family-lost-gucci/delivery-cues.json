      "pause_after_seconds": 1,
      "pronunciation_notes": [],
      "inflection": "settled"
    },
    {
      "paragraph_id": "P025",
      "anchor": "That distinction matters. A successful turnaround after a sale do",
      "pace": "slower",
      "intent": "reflective",
      "emphasis": [
        "cannot rerun the company"
